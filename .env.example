# ── Required ────────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)
APP_SECRET=               # Long random string — signs the session-cookie JWT

# ── Bootstrap admin account ─────────────────────────────────────
# Created on first boot; restarting with a new ADMIN_PASSWORD resets it.
ADMIN_EMAIL=              # e.g. admin@olljira.com
ADMIN_PASSWORD=           # choose a strong password (min 8 chars)
